/// Source for main.yml — regenerate with `mise run gen-workflows`.
amends "@com.github.actions/Workflow.pkl"

name = "release"

on {
  workflow_dispatch = new {}
  push = new {
    tags { "*" }
    branches { "main" }
  }
}

concurrency {
  group = "\(module.context.github.workflow)-\(module.context.github.ref)"
  `cancel-in-progress` = true
}

env {
  ["MISE_EXPERIMENTAL"] = "true"
  // The built-in GITHUB_TOKEN authenticates gh (release create/upload) in the
  // release job and lets mise authenticate its GitHub downloads (rate limits).
  // The release job grants it contents: write via permissions below.
  ["GITHUB_TOKEN"] = "${{ secrets.GITHUB_TOKEN }}"
}

local miseSetupSteps = new Listing<Step> {
  new {
    uses = "actions/checkout@v7"
  }
  // install: false — mise-action auto-adds --locked when mise.lock exists, and
  // the lock lacks linux-x64 (glibc) URLs for erlang and conda:xz-tools, so a
  // strict install aborts. cache: false because mise-action only saves a cache
  // for tools IT installs; with install: false it saves nothing, so we cache
  // the mise data dir explicitly below instead.
  new {
    uses = "jdx/mise-action@v4"
    with {
      ["version"] = "2026.8.5"
      ["install"] = false
      ["cache"] = false
    }
  }
  new {
    uses = "actions/cache@v6"
    with {
      // runner.arch is in the key because runner.os is "Linux" for both x64
      // and arm64 runners; without it the two would share a key and restore
      // each other's incompatible binaries.
      ["path"] = "~/.local/share/mise"
      ["key"] = "mise-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('mise.lock') }}"
      ["restore-keys"] = "mise-${{ runner.os }}-${{ runner.arch }}-"
    }
  }
  new {
    run = "mise install"
  }
}

// Build jobs also cache Burrito's download cache (Burrito.Util.FileCache),
// which holds the per-target ERTS and musl runtime, so each is downloaded once
// and reused across runs. The path is OS-specific (Linux ~/.cache,
// macOS ~/Library/Caches); actions/cache caches whichever exists. github.job is
// in the key so each build job (its targets, and thus its ERTS, differ) gets
// its own cache.
local buildSetupSteps = new Listing<Step> {
  ...miseSetupSteps
  new {
    uses = "actions/cache@v6"
    with {
      ["path"] = """
        ~/.cache/burrito_file_cache
        ~/Library/Caches/burrito_file_cache
        """
      ["key"] = "burrito-${{ github.job }}-${{ hashFiles('mise.lock') }}"
      ["restore-keys"] = "burrito-${{ github.job }}-"
    }
  }
}

jobs {
  // Builds both linux binaries on an arm64 runner: linux_aarch64 natively and
  // linux (x86_64) cross-compiled via zig, both with Burrito's precompiled
  // ERTS (custom_erts can't be used on linux — it skips Burrito's musl step).
  ["build-linux"] {
    `runs-on` = "ubuntu-24.04-arm"
    `timeout-minutes` = 30
    steps {
      ...buildSetupSteps
      new {
        run = """
          mise run deps-prod
          mise exec -- elixir images/build-images-readme.exs
          BURRITO_TARGET=linux mise run release
          BURRITO_TARGET=linux_aarch64 mise run release
          """
      }
      new {
        uses = "actions/upload-artifact@v7"
        with {
          ["name"] = "burrito-linux"
          ["path"] = "burrito_out/"
          ["if-no-files-found"] = "error"
        }
      }
    }
  }

  // Cross-builds the windows binary (via zig) with Burrito's downloaded ERTS.
  // Split from build-linux so it runs in parallel. runner arch is irrelevant
  // for this cross-build.
  ["build-windows"] {
    `runs-on` = "ubuntu-24.04-arm"
    `timeout-minutes` = 30
    steps {
      ...buildSetupSteps
      new {
        run = """
          mise run deps-prod
          BURRITO_TARGET=windows mise run release
          """
      }
      new {
        uses = "actions/upload-artifact@v7"
        with {
          ["name"] = "burrito-windows"
          ["path"] = "burrito_out/"
          ["if-no-files-found"] = "error"
        }
      }
    }
  }

  // Builds macos_m1 natively on an arm64 runner so Burrito reuses the
  // mise-installed OTP instead of downloading the universal CDN ERTS, and
  // cross-builds macos (Intel/x86_64, deprecated) with the CDN ERTS.
  // Uploads the raw burrito_out binaries as an artifact.
  ["build-macos"] {
    `runs-on` = "macos-latest"
    `timeout-minutes` = 30
    steps {
      ...buildSetupSteps
      new {
        run = """
          mise run deps-prod
          BURRITO_TARGET=macos_m1 mise run release
          BURRITO_TARGET=macos mise run release
          """
      }
      new {
        uses = "actions/upload-artifact@v7"
        with {
          ["name"] = "burrito-macos"
          ["path"] = "burrito_out/"
          ["if-no-files-found"] = "error"
        }
      }
    }
  }

  // Single releasing job: downloads all target binaries into one burrito_out/
  // so version-info.exs renames them, generates one checksums.txt covering
  // every platform, creates the GitHub release, and uploads all artifacts.
  ["release"] {
    `runs-on` = "ubuntu-24.04-arm"
    `timeout-minutes` = 15
    // contents: write lets the built-in GITHUB_TOKEN create the release and
    // upload assets.
    permissions {
      contents = "write"
    }
    needs {
      "build-linux"
      "build-windows"
      "build-macos"
    }
    steps {
      ...miseSetupSteps
      // merge-multiple flattens the burrito-* artifacts into a single
      // burrito_out/ (no per-artifact subdirectories).
      new {
        uses = "actions/download-artifact@v8"
        with {
          ["path"] = "burrito_out"
          ["pattern"] = "burrito-*"
          ["merge-multiple"] = true
        }
      }
      new {
        run = "mise exec -- elixir version-info.exs"
      }
    }
  }
}
