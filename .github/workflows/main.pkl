/// Source for main.yml — regenerate with `mise run gen-workflows`.
amends "@com.github.actions/Workflow.pkl"

name = "release"

on {
  workflow_dispatch = new {}
  push = new {
    tags { "*" }
    branches { "main" }
  }
}

concurrency {
  group = "\(module.context.github.workflow)-\(module.context.github.ref)"
  `cancel-in-progress` = true
}

env {
  ["MISE_EXPERIMENTAL"] = "true"
  ["GH_TOKEN"] = "${{ secrets.GH_TOKEN }}"
}

local miseSetupSteps = new Listing<Step> {
  new {
    uses = "actions/checkout@v4"
  }
  // install: false because mise-action auto-adds --locked when mise.lock
  // exists, and tools without a precompiled URL (elixir-ls) abort it;
  // the plain `mise install` below reads the lock where URLs exist.
  new {
    uses = "jdx/mise-action@v4"
    with {
      ["version"] = "2026.8.5"
      ["install"] = false
    }
  }
  new {
    run = "mise install"
  }
}

jobs {
  // Builds the linux target with the mise-installed OTP as Burrito's ERTS
  // (no CDN download) and cross-builds windows with Burrito's downloaded
  // ERTS. Uploads the raw burrito_out binaries as an artifact; the release
  // job below renames + checksums them together with the macOS build.
  ["build-linux"] {
    `runs-on` = "ubuntu-latest"
    `timeout-minutes` = 30
    steps {
      ...miseSetupSteps
      new {
        run = """
          mise run deps-prod
          mise exec -- elixir images/build-images-readme.exs
          BURRITO_TARGET=linux mise run release
          BURRITO_TARGET=windows mise run release
          """
      }
      new {
        uses = "actions/upload-artifact@v4"
        with {
          ["name"] = "burrito-linux"
          ["path"] = "burrito_out/"
          ["if-no-files-found"] = "error"
        }
      }
    }
  }

  // Builds the macos_m1 target natively on an arm64 runner so Burrito
  // reuses the mise-installed OTP instead of downloading the universal CDN
  // ERTS. Uploads its raw burrito_out binary as an artifact.
  ["build-macos"] {
    `runs-on` = "macos-latest"
    `timeout-minutes` = 30
    steps {
      ...miseSetupSteps
      new {
        run = """
          mise run deps-prod
          BURRITO_TARGET=macos_m1 mise run release
          """
      }
      new {
        uses = "actions/upload-artifact@v4"
        with {
          ["name"] = "burrito-macos"
          ["path"] = "burrito_out/"
          ["if-no-files-found"] = "error"
        }
      }
    }
  }

  // Single releasing job: downloads all target binaries into one burrito_out/
  // so version-info.exs renames them, generates one checksums.txt covering
  // every platform, creates the GitHub release, and uploads all artifacts.
  ["release"] {
    `runs-on` = "ubuntu-latest"
    `timeout-minutes` = 15
    needs {
      "build-linux"
      "build-macos"
    }
    steps {
      ...miseSetupSteps
      // merge-multiple flattens burrito-linux/ and burrito-macos/ into a
      // single burrito_out/ (no per-artifact subdirectories).
      new {
        uses = "actions/download-artifact@v4"
        with {
          ["path"] = "burrito_out"
          ["pattern"] = "burrito-*"
          ["merge-multiple"] = true
        }
      }
      new {
        run = "mise exec -- elixir version-info.exs"
      }
    }
  }
}
