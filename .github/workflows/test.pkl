/// Source for test.yml — regenerate with `mise run gen-workflows`.
amends "@com.github.actions/Workflow.pkl"

name = "test"

on {
  workflow_dispatch = new {}
  push = new {}
}

concurrency {
  group = "\(module.context.github.workflow)-\(module.context.github.ref)"
  `cancel-in-progress` = true
}

env {
  ["MISE_EXPERIMENTAL"] = "true"
}

jobs {
  ["test"] {
    `runs-on` = "ubuntu-latest"
    `timeout-minutes` = 10
    steps {
      new {
        uses = "actions/checkout@v4"
      }
      // install: false because mise-action auto-adds --locked when mise.lock
      // exists, and tools without a lockfile URL (elixir-ls, asdf backend)
      // abort it; the plain `mise install` below is non-strict: it uses locked
      // URLs where present and installs the URL-less tools normally.
      new {
        uses = "jdx/mise-action@v4"
        with {
          ["version"] = "2026.8.5"
          ["install"] = false
        }
      }
      new {
        run = "mise install"
      }
      new {
        run = "mise run test"
      }
    }
  }
}
